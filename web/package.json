{
  "name": "avid-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Avid 前端：会话时间线、审批队列、任务板、技能目录与设置",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "node scripts/check-style.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "gate:size": "node scripts/gate-size.mjs",
    "copy:dist": "node scripts/copy-dist.mjs",
    "test:e2e": "playwright test",
    "verify": "pnpm run check:layers && pnpm run check:tokens && pnpm run lint && pnpm run test && pnpm run gate:size"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.27.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
