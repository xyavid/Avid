{
  "name": "avid-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Avid 前端（纸本视觉重建）：设计 token 见 src/styles/tokens.css",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "copy:dist": "node scripts/copy-dist.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "gate:size": "node scripts/gate-size.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run gate:size"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/pt-serif": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
