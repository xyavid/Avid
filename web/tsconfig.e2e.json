/**
 * E2E 的独立 typecheck 配置。
 *
 * 为什么**不**并进根 `tsconfig.json`：两边的运行环境不同——E2E 跑在 Node 里、
 * 用 Playwright 的类型与服务端的 `process`，而 `src/` 跑在浏览器里、带 `vite/client`。
 * 并到一起就得给根配置加上 Node 类型，那会让浏览器侧代码也能"合法地"引用
 * `process`、`fs` 这类只在 Node 存在的东西，类型检查就守不住边界了。
 *
 * 所以拆成两份配置，`pnpm typecheck` 两条都跑。
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // E2E 只跑在 Node 里，不必背 DOM 之外的浏览器假设；DOM 留着是因为
    // spec 里要写 evaluate 回调（在浏览器里执行），类型得能认出 document。
    "types": ["node", "@playwright/test"]
  },
  "include": ["e2e", "playwright.config.ts"],
  // 显式覆盖 `extends` 继承来的 exclude：根配置把 e2e/ 排除了（那是给浏览器侧用的），
  // 继承下来会让这份配置找不到任何输入文件，报 TS18003。
  "exclude": ["node_modules", "dist"]
}
