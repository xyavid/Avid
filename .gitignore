__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
.ruff_cache/
.seiso_cache/
.avid/
.tasks/
.zcodeignore

build/
dist/
*.egg-info/

# ---- 前端 ----

# 依赖与产物不入库：`pnpm -C web build && pnpm -C web run copy:dist` 会把 dist/
# 复制进 avid/web/static/（随 wheel 分发）。构建戳也在产物里。
web/node_modules/
web/dist/
# tsc -b 的增量缓存：构建产物，不入库（否则每次构建都产生无意义 diff）
web/tsconfig.tsbuildinfo
*.tsbuildinfo
web/playwright-report/
web/test-results/
/avid/web/static/*
!/avid/web/static/.gitkeep

# dev/ 过程文档：开发计划、需求草稿、进度跟踪、笔记、会议记录、阶段出图。
# 只保留在本地，不参与版本管理。
/dev/
