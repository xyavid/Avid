__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
.avid/
.tasks/
build/
dist/
*.egg-info/

# ---- 前端 ----

# 依赖与产物不入库：`pnpm -C web build && pnpm -C web run copy:dist` 会把 dist/
# 复制进 src/avid/web/static/（随 wheel 分发）。构建戳也在产物里。
web/node_modules/
web/dist/
# tsc -b 的增量缓存：构建产物，不入库（否则每次构建都产生无意义 diff）
web/tsconfig.tsbuildinfo
*.tsbuildinfo
web/playwright-report/
web/test-results/
/src/avid/web/static/*
!/src/avid/web/static/.gitkeep

# ---- 文档入库规则：正式文档进 docs/，过程文档留 dev/ ----

# docs/ 白名单：默认全部忽略，只放行下面五类正式文档目录。
# 新文件落在 docs/ 根目录或未知子目录时自动被忽略，不会误提交。
/docs/*
!/docs/README.md
!/docs/guide/
!/docs/api/
!/docs/deploy/
!/docs/design/
# status/：项目现状五问集（现状 / 能力 / 基准 / 架构 / 路线），
# 文件名沿用大写 SCREAMING_SNAKE 以便与 design/ 下的规格文档区分。
!/docs/status/

# dev/ 过程文档：开发计划、需求草稿、进度跟踪、笔记、会议记录、阶段出图。
# 只保留在本地，不参与版本管理。
/dev/
