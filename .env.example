# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，密钥不入库。

# 必填：服务商签发的 API Key
AVID_API_KEY=

# 选填：OpenAI 兼容接口的根地址，默认 https://api.openai.com/v1
AVID_BASE_URL=https://api.openai.com/v1

# 必填：模型名，例如 deepseek-chat / gpt-4o-mini
AVID_MODEL=

# 选填：模型上下文窗口（tokens）。用来算界面上「上下文占用」的百分比：
# 不设时按模型名查内置小表（见 src/avid/ai/config.py 的 MODEL_CONTEXT_WINDOWS），
# 查不到就只显示 tokens、不显示占用率（错的分母比没有分母更糟）。
# 写了非法值（如 128k）会直接报错，不静默回落。
AVID_CONTEXT_WINDOW=

# 选填：关掉「向 provider 问模型窗口」的探测。缺省开启——只在上面两项都查不到时，
# 向 {base_url}/models 问一次该模型的 context_length（进程内缓存、失败静默、不进关键路径）。
# AVID_MODEL_INFO=off

# ---- 联网检索（web_search 工具，可选能力）----
# 留空时只有 web_search 会失败关闭，模型调用、会话、Web 服务不受影响。
# 申请地址：https://app.tavily.com（有免费额度）
TAVILY_API_KEY=

# 选填：检索接口根地址，默认 https://api.tavily.com
# TAVILY_BASE_URL=https://api.tavily.com
